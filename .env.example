# Copy to `.env` (git-ignored) to enable the Contact form. With any key blank
# the site builds fine and Contact shows a mailto link instead of the form.

# EmailJS service id (https://dashboard.emailjs.com/admin)
VITE_EMAILJS_SERVICE_ID=
# EmailJS template id; the template receives from_name, from_email, subject, message
VITE_EMAILJS_TEMPLATE_ID=
# EmailJS public key (https://dashboard.emailjs.com/admin/account)
VITE_EMAILJS_PUBLIC_KEY=
